<!DOCTYPE html>
<html lang="en"{{{ theme ? ` data-theme="${theme}"` : '' }}}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Orbit</title>
  <link rel="icon" href="{{ favicon }}">
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f7f9;
      --card: #ffffff;
      --side: #ffffff;
      --line: #e3e6ea;
      --text: #1b1f23;
      --muted: #6b7280;
      --accent: #4338ca;
      --accent-soft: #eef2ff;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #14171a; --card: #1c2024; --side: #191d21; --line: #2c3238;
        --text: #e8eaed; --muted: #9aa3ad; --accent: #a5b4fc; --accent-soft: #312e81;
      }
    }
    /* A person who chose reads what they chose, whatever the machine says. */
    :root[data-theme="light"] {
      color-scheme: light;
      --bg: #f6f7f9; --card: #ffffff; --side: #ffffff; --line: #e3e6ea;
      --text: #1b1f23; --muted: #6b7280; --accent: #4338ca; --accent-soft: #eef2ff;
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #14171a; --card: #1c2024; --side: #191d21; --line: #2c3238;
      --text: #e8eaed; --muted: #9aa3ad; --accent: #a5b4fc; --accent-soft: #312e81;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; display: flex; min-height: 100vh; background: var(--bg); color: var(--text);
      font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    aside {
      width: 220px; flex: 0 0 220px; background: var(--side);
      border-right: 1px solid var(--line); padding: 20px 12px;
      display: flex; flex-direction: column;
      position: sticky; top: 0; height: 100vh; overflow-y: auto;
    }
    .theme { margin-top: auto; padding-top: 18px; }
    .theme button {
      display: flex; align-items: center; gap: 10px; width: 100%;
      padding: 8px 10px; border: 0; border-radius: 6px; cursor: pointer;
      background: none; color: var(--muted); font: inherit; text-align: left;
    }
    .theme button:hover { background: var(--bg); color: var(--text); }
    /*
     * The page shows the mode that the person does not read now. The machine
     * says which one that is while nobody chose, thus the page asks it here
     * and no script asks it later.
     */
    .to-light { display: none; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme]) .to-light { display: flex; }
      :root:not([data-theme]) .to-dark { display: none; }
    }
    :root[data-theme="dark"] .to-light { display: flex; }
    :root[data-theme="dark"] .to-dark { display: none; }
    :root[data-theme="light"] .to-light { display: none; }
    :root[data-theme="light"] .to-dark { display: flex; }
    .brand {
      font-weight: 600; font-size: 15px; padding: 0 10px 18px;
      display: flex; align-items: center; gap: 8px;
    }
    .brand span { color: var(--muted); font-weight: 400; }
    .brand svg { width: 30px; height: 30px; flex: none; }
    nav a {
      display: flex; align-items: center; gap: 10px; padding: 8px 10px; margin-bottom: 2px;
      border-radius: 6px; color: inherit; text-decoration: none;
    }
    nav a:hover { background: var(--bg); }
    nav a.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
    nav a svg { flex: 0 0 16px; }
    nav a .count {
      margin-left: auto; font-size: 12px; color: var(--muted);
      background: var(--bg); border-radius: 999px; padding: 1px 8px;
    }
    nav a.active .count { background: var(--card); color: var(--accent); }
    main { flex: 1; padding: 24px 28px; min-width: 0; }
    h1 { font-size: 20px; margin: 0 0 20px; }
    h2 { font-size: 15px; margin: 28px 0 12px; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
    .card {
      background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 16px;
    }
    .card .value { font-size: 26px; font-weight: 600; letter-spacing: -0.5px; }
    .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; margin-top: 4px; }
    .panel { background: var(--card); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; min-width: 860px; }
    th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { font-weight: 600; color: var(--muted); font-size: 12px; text-transform: uppercase; }
    tr:last-child td { border-bottom: none; }
    .status { padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .pending { background: #e5e7eb; color: #374151; }
    .running { background: #dbeafe; color: #1e40af; }
    .retrying { background: #fef3c7; color: #92400e; }
    .completed { background: #d1fae5; color: #065f46; }
    .failed { background: #fee2e2; color: #991b1b; }
    .lost { background: #ede9fe; color: #5b21b6; }
    .muted { color: var(--muted); font-size: 12px; }
    .actions { display: flex; gap: 6px; align-items: center; }
    .actions a { color: inherit; white-space: nowrap; }
    button {
      font: inherit; font-size: 13px; padding: 5px 10px; border-radius: 6px; cursor: pointer;
      border: 1px solid var(--line); background: var(--card); color: inherit;
    }
    button:hover { border-color: var(--accent); color: var(--accent); }
    pre {
      margin: 8px 0 0; padding: 10px; background: var(--bg); border-radius: 6px;
      overflow-x: auto; font-size: 12px; max-width: 520px; white-space: pre-wrap;
    }
    details summary { cursor: pointer; color: var(--muted); font-size: 12px; }
    .pager {
      display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
      margin: 16px 0; font-size: 13px;
    }
    .pager a { color: inherit; }
    .pager form { display: inline; }
    .page {
      display: inline-block; min-width: 30px; padding: 4px 8px; border-radius: 6px;
      border: 1px solid var(--line); background: var(--card); text-align: center;
      text-decoration: none; font: inherit; font-size: 13px; color: inherit; cursor: pointer;
    }
    a.page:hover, button.page:hover { border-color: var(--accent); color: var(--accent); }
    .page.current {
      border-color: var(--accent); background: var(--accent-soft);
      color: var(--accent); font-weight: 600; cursor: default;
    }
    .rows { display: flex; gap: 6px; align-items: center; margin-left: auto; }
    .empty { padding: 28px; text-align: center; color: var(--muted); }
  </style>
</head>
<body>
  <aside>
    <div class="brand">{{{ logo }}}Orbit <span>for AdonisJS</span></div>
    <nav>
      @each(item in menu)
        <a href="{{ item.href }}" class="{{ item.key === active ? 'active' : '' }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{{ item.icon }}}</svg>
          {{ item.label }}
          @if(item.count !== null)
            <span class="count">{{ item.count }}</span>
          @end
        </a>
      @end
    </nav>
    <div class="theme">
      <form method="post" action="{{ path }}/theme/dark">
        @if(csrfToken)
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        @end
        <button type="submit" class="to-dark">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 13a8.5 8.5 0 0 1-10-10 8.5 8.5 0 1 0 10 10z"/>
          </svg>
          Dark
        </button>
      </form>
      <form method="post" action="{{ path }}/theme/light">
        @if(csrfToken)
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        @end
        <button type="submit" class="to-light">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4.5"/>
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>
          </svg>
          Light
        </button>
      </form>
    </div>
  </aside>

  <main>
    <h1>{{ title }}</h1>
    {{{ await $slots.main() }}}
  </main>
</body>
</html>
